{
 "name": "evolved-zone",
 "productName": "Evolved Zone",
 "version": "0.16.0",
 "description": "Evolved Zone - battle royale nel Valdarno",
 "main": "main.js",
 "author": "Michele",
 "license": "UNLICENSED",
 "build": {
  "appId": "it.evolvedzone.gioco",
  "productName": "Evolved Zone",
  "files": [
   "main.js",
   "preload.js",
   "game/**",
   "icon.png",
   "icon.ico"
  ],
  "directories": {
   "output": "dist"
  },
  "win": {
   "target": [
    "nsis"
   ],
   "icon": "icon.ico"
  },
  "nsis": {
   "oneClick": false,
   "perMachine": false,
   "allowToChangeInstallationDirectory": true,
   "createDesktopShortcut": true,
   "shortcutName": "Evolved Zone",
   "artifactName": "EvolvedZone-Setup.exe"
  },
  "portable": {
   "artifactName": "EvolvedZone-Portable-${version}.exe"
  },
  "protocols": [
   {
    "name": "Evolved Zone",
    "schemes": [
     "evolvedzone"
    ]
   }
  ]
 },
 "devDependencies": {
  "electron": "44.8.0",
  "electron-builder": "26.15.3"
 }
}